{
  "name": "livechat",
  "author": "CramoiSel",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.livechat",
    "productName": "LiveChat",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**",
      "electron/**",
      "node_modules/**",
      "package.json",
      "models/**",
      "!node_modules/youtube-dl-exec/bin/**"
    ],
    "win": {
      "icon": "electron/assets/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "electron/assets/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "icon": "electron/assets/icon.png",
      "artifactName": "${productName}-${version}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Grahaam",
        "repo": "discord-obs-overlay"
      }
    ],
    "nsis": {
      "include": "electron/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "en_US",
        "fr_FR"
      ]
    },
    "electronLanguages": [
      "en-US",
      "fr"
    ]
  },
  "scripts": {
    "postinstall": "node scripts/setup-yt-dlp.cjs",
    "dev": "node scripts/run-with-venv.cjs tsx server/index.ts",
    "build": "npm run typecheck && vite build && node scripts/copy-mediapipe-wasm.cjs && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node scripts/run-with-venv.cjs node dist/server.mjs",
    "stop": "npx kill-port 3000",
    "clean": "node --eval \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "npx tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "node --import tsx --test \"server/**/*.test.ts\" \"src/**/*.test.ts\" \"scripts/**/*.test.cjs\"",
    "test:media": "node scripts/run-with-venv.cjs tsx scripts/test-media-queue.ts",
    "test:media:filter": "node scripts/run-with-venv.cjs tsx scripts/test-media-queue.ts --filter",
    "gen-icons": "node scripts/gen-icons.cjs",
    "electron:dev": "npm run build && node scripts/fetch-pose-model.cjs && electron .",
    "electron:build": "npm run build && node scripts/fetch-pose-model.cjs && node scripts/fetch-ytdlp.cjs && electron-builder --publish never",
    "electron:build:win": "npm run build && node scripts/fetch-pose-model.cjs && node scripts/fetch-ytdlp.cjs --platform win32 && electron-builder --win --publish never",
    "electron:build:mac": "npm run build && node scripts/fetch-pose-model.cjs && node scripts/fetch-ytdlp.cjs --platform darwin && electron-builder --mac --arm64 --publish never && electron-builder --mac --x64 --publish never",
    "electron:build:linux": "npm run build && node scripts/fetch-pose-model.cjs && node scripts/fetch-ytdlp.cjs --platform linux && electron-builder --linux --publish never",
    "predev": "node scripts/fetch-pose-model.cjs --optional"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "electron-updater": "^6.8.12",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "ffmpeg-static": "^5.3.0",
    "metascraper": "^5.58.5",
    "metascraper-amazon": "^5.58.4",
    "metascraper-author": "^5.58.5",
    "metascraper-description": "^5.58.4",
    "metascraper-image": "^5.58.4",
    "metascraper-logo": "^5.58.4",
    "metascraper-spotify": "^5.58.4",
    "metascraper-title": "^5.58.4",
    "metascraper-url": "^5.58.4",
    "metascraper-youtube": "^5.58.4",
    "mime": "^4.1.1",
    "obs-websocket-js": "^5.0.8",
    "p-queue": "^10.0.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "socket.io": "^4.8.4",
    "youtube-dl-exec": "^3.1.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@eslint/js": "^10.0.1",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^26.6.5",
    "@types/pino": "^7.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.1.2",
    "audiomotion-analyzer": "^4.5.4",
    "autoprefixer": "^10.6.1",
    "electron": "^45.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "lucide-react": "^1.61.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "re2@1.27.0": true,
    "youtube-dl-exec@3.1.17": true
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
