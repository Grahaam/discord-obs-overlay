{
  "name": "discord-obs-overlay",
  "private": true,
  "version": "1.9.5",
  "type": "module",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.livechat",
    "productName": "LiveChat",
    "asar": false,
    "npmRebuild": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**",
      "electron/**",
      "node_modules/**",
      "package.json"
    ],
    "win": {
      "icon": "electron/assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "electron/assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "icon": "electron/assets/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    }
  },
  "scripts": {
    "postinstall": "node scripts/setup-yt-dlp.cjs",
    "dev": "node scripts/run-with-venv.cjs tsx server/index.ts",
    "build": "npm run typecheck && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node scripts/run-with-venv.cjs node dist/server.mjs",
    "stop": "npx kill-port 3000",
    "clean": "node --eval \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "npx tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "node --import tsx --test \"server/**/*.test.ts\"",
    "test:media": "node scripts/run-with-venv.cjs tsx scripts/test-media-queue.ts",
    "test:media:filter": "node scripts/run-with-venv.cjs tsx scripts/test-media-queue.ts --filter",
    "gen-icons": "node scripts/gen-icons.cjs",
    "electron:rebuild": "node -e \"require('@electron/rebuild').rebuild({buildPath:process.cwd(),electronVersion:require('./node_modules/electron/package.json').version,force:true,onlyModules:['better-sqlite3']}).then(()=>console.log('rebuild ok')).catch(e=>{console.error(e.message);process.exit(1)})\"",
    "electron:dev": "npm run build && npm run electron:rebuild && electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express-rate-limit": "^5.1.3",
    "audiomotion-analyzer": "^4.5.4",
    "axios": "^1.7.2",
    "better-sqlite3": "^12.10.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "ffmpeg-static": "^5.3.0",
    "link-preview-js": "^4.0.3",
    "lucide-react": "^1.17.0",
    "metascraper": "^5.50.6",
    "metascraper-amazon": "^5.50.6",
    "metascraper-author": "^5.50.6",
    "metascraper-description": "^5.50.6",
    "metascraper-image": "^5.50.6",
    "metascraper-logo": "^5.50.6",
    "metascraper-spotify": "^5.50.6",
    "metascraper-title": "^5.50.6",
    "metascraper-url": "^5.50.6",
    "metascraper-youtube": "^5.50.6",
    "mime": "^4.1.0",
    "obs-websocket-js": "^5.0.8",
    "p-queue": "^9.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "youtube-dl-exec": "^3.1.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pino": "^7.0.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.21",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "prettier": "^3.3.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14"
  },
  "allowScripts": {
    "electron@35.7.5": true
  }
}
